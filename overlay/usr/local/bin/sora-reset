#!/bin/sh

echo "[Sora-OS] Resetting Wi-Fi & first-boot setup state..."
rm -f /var/lib/sora-os/wifi_initialized

if command -v nmcli >/dev/null 2>&1; then
  for conn in $(nmcli -t -f NAME,TYPE connection show | awk -F: '$2=="802-11-wireless"{print $1}'); do
    nmcli connection delete "$conn" >/dev/null 2>&1 || true
  done
fi

echo "[Sora-OS] Reset complete. Next startup will run first-time Wi-Fi setup."
